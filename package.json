{
  "name": "pi-iterative-goal",
  "version": "0.1.0",
  "description": "Autonomous supervisor loop Pi extension - never stops until external evaluator returns goal_met=true. Features capability preflight, error classification, safe shell, subagent adapter, and compaction recovery.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "pi": {
    "extensions": [
      "./dist/pi-iterative-goal.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/smoke-goal-harness.mjs",
    "test:trusted-security": "npm run build && node scripts/test-trusted-security.mjs",
    "test:trusted-dependencies": "npm run build && node scripts/test-trusted-dependencies.mjs",
    "test:prod-feature-matrix": "npm run build && node scripts/test-prod-feature-matrix.mjs",
    "smoke:compiled": "node scripts/smoke-goal-harness.mjs && node scripts/telemetry-retention-smoke.mjs && node scripts/test-model-roster.mjs && node scripts/test-model-failover.mjs && node scripts/test-prod-feature-matrix.mjs && node scripts/test-bounded-tree-snapshot.mjs && node scripts/test-trusted-dependencies.mjs && node scripts/test-trusted-security.mjs && node scripts/test-workspace-hardening.mjs && node scripts/test-long-session-lifecycle.mjs && node scripts/test-agent-budgets.mjs && node scripts/test-worker-containment.mjs",
    "smoke": "npm run build && npm run smoke:compiled",
    "lint": "tsc --noEmit",
    "format:check": "node -e \"console.log('format:check: no formatter configured')\"",
    "validate": "npm run models:runtime:check && npm run models:runtime:test && npm run typecheck && npm run smoke",
    "watch": "tsc -w",
    "env:models": "node scripts/materialize-model-provider-env.mjs",
    "models:runtime:preview": "node scripts/materialize-goal-runtime.mjs",
    "models:runtime:check": "node scripts/materialize-goal-runtime.mjs --check",
    "models:runtime:test": "node scripts/test-model-runtime.mjs",
    "goal:runtime": "node scripts/run-goal-runtime.mjs",
    "goal:runtime:materialize": "node scripts/run-goal-runtime.mjs --materialize-only",
    "goal:tmux": "node scripts/run-goal-tmux.mjs",
    "models:probe": "node --env-file-if-exists=.env scripts/model-roster-probe.mjs",
    "models:probe:live": "node --env-file-if-exists=.env scripts/model-roster-probe.mjs --live",
    "models:compare:workers": "npm run build && node --env-file-if-exists=.env scripts/live-worker-matrix.mjs",
    "prod:runtime:confirm": "npm run build && node scripts/prod-runtime-confirmation.mjs",
    "prod:features:confirm": "npm run build && node scripts/prod-feature-matrix.mjs",
    "trusted:head": "npm run build && node scripts/run-trusted-head.mjs",
    "probe:zai": "npm run build && node scripts/probe-zai-glm52.mjs --env-file .env",
    "review:prod-security:readonly": "node scripts/prod-security-review-readonly.mjs --handoff /Users/joe/Downloads/third-party-prod-security-review-handoff-2026-06-29.md --max-iterations 1",
    "review:prod-security:continuous": "node scripts/prod-security-review-readonly.mjs --handoff /Users/joe/Downloads/third-party-prod-security-review-handoff-2026-06-29.md --continuous",
    "evidence:headless": "node scripts/headless-feature-evidence.mjs",
    "evidence:headless:self-compare": "PI_ENABLE_SELF_CAPABILITY_COMPARISON=1 node scripts/headless-feature-evidence.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "^0.75.5",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.75.5",
    "@earendil-works/pi-ai": "^0.75.5",
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@earendil-works/pi-tui": "^0.75.5",
    "typescript": "^5.0.0"
  }
}
